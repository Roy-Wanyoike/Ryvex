# Ryvex environment template — copy to .env (git-ignored) and fill in.
#
#   ryvexd reads its variables directly from the process environment (or the
#   equivalent CLI flags — see `ryvexd serve --help`). The console reads
#   NEXT_PUBLIC_* vars at build time (`bun run build` in console/).
#
# Every value below is a safe local default or an obvious placeholder;
# nothing here is a real credential.

# ---- ryvexd (control plane daemon) ------------------------------------------

# HTTP listen address for the /v1 API and /healthz.
RYVEX_HTTP_ADDR=:8080

# Static API keys as comma-separated name=token pairs. Tokens must start
# with ryk_. Each entry is bootstrapped as an admin key (org/* scope).
# Generate one with:  openssl rand -hex 24 | sed 's/^/ryk_/'
# Leave empty in dev and pass --dev-auth instead (loopback only).
RYVEX_API_KEYS=ops=ryk_change_me_local_dev

# Postgres DSN — required when the server runs with --store=postgres.
# The bundled docker-compose.yml starts a matching Postgres on 127.0.0.1.
RYVEX_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ryvex?sslmode=disable

# NATS server URL used when the server runs with --bus=nats (JetStream).
RYVEX_NATS_URL=nats://127.0.0.1:4222

# Dedicated listen address for /metrics (Prometheus exposition) and a
# /healthz passthrough. Empty string disables the metrics endpoint.
RYVEX_METRICS_ADDR=:9090

# Browser origins allowed to call the API (CORS), comma-separated.
# The console dev server runs on http://localhost:3100.
RYVEX_CORS_ORIGINS=http://localhost:3100

# HMAC key material for webhook signature headers. When unset, a random
# secret is generated per boot and deliveries cannot be verified across
# restarts — set a stable value once you rely on webhook deliveries.
RYVEX_WEBHOOK_SECRET=

# Documented operator opt-ins (leave unset unless you need them):
#   1) allow --dev-auth together with --store postgres / --bus nats
# RYVEX_ALLOW_DEV_AUTH=1
#   2) allow webhook Subscription targets on private/loopback addresses
# RYVEX_ALLOW_PRIVATE_WEBHOOKS=1

# ---- console (Next.js, build-time public env) -------------------------------
# Prefix NEXT_PUBLIC_ = these are embedded into the browser bundle; never
# put a production-grade secret here. The console also accepts runtime
# overrides from its Settings view — runtime values win over these, and
# the token is special: it lives in sessionStorage only (see below).

# Base URL of the control plane API, e.g. http://localhost:8080.
# Empty => the console renders demo data only.
NEXT_PUBLIC_RYVEX_API=http://localhost:8080

# Bearer token (Authorization: Bearer ryk_…) — deliberately NOT templated.
# A NEXT_PUBLIC_* value is compiled into every browser bundle, so a token
# set here would ship to each visitor: the exact credential-leak class
# issue #42 attacked. The only supported console path is runtime entry
# via the Settings view: the token is kept in sessionStorage (per tab,
# gone when the tab closes) and never persisted to localStorage or the
# build.

# Default scope the console browses (must match applied resources).
NEXT_PUBLIC_RYVEX_ORG=acme
NEXT_PUBLIC_RYVEX_PROJECT=core
NEXT_PUBLIC_RYVEX_ENV=prod

# ---- ryvex-agent (Rust node agent; compose "agent" profile) ----------------
#
# Enrolls its host as a Node resource and heartbeats with CAS-safe
# GET/PUT upserts (no listen port). The names below are verbatim from
# agent/ryvex-agent/src/config.rs — clap `env =` attributes, all 9 of
# them (issue #76). The k8s DaemonSet (deploy/k8s/07-ryvex-agent.yaml)
# wires the same names.

# Control plane base URL. Inside the compose network use the service
# name: http://ryvexd:8080.
RYVEX_AGENT_API=http://127.0.0.1:8080

# Bearer API key (ryk_…). Required — the agent refuses to start with an
# empty or non-ryk_ token. Mint a scoped key via POST /v1/keys or use a
# static --api-keys entry whose scope covers org/project/env below.
RYVEX_AGENT_TOKEN=

# Heartbeat interval in seconds (clamped to >= 5).
RYVEX_AGENT_INTERVAL=10

# Node resource name. Empty = HOSTNAME env var, else the kernel hostname;
# a "localhost" result is refused (issue #43). Pin a stable name for
# hosts that matter.
RYVEX_AGENT_NAME=

# Cluster label carried on the node resource.
RYVEX_AGENT_CLUSTER=unassigned

# Scope of the Node resource: /v1/{org}/{project}/{env}/nodes/{name}.
RYVEX_AGENT_ORG=acme
RYVEX_AGENT_PROJECT=core
RYVEX_AGENT_ENV=prod

# Min seconds between spec.last_seen refreshes (the heartbeat
# spec-throttle; between refreshes the document is resent identical so
# no generation bump / event is emitted).
RYVEX_AGENT_SPEC_REFRESH_SECS=300
