# Build artifacts
/bin/
/dist/
/target/
*.exe
*.test
*.out

# Toolchains (local only)
/.toolchain/

# Node / Next.js
# The console is bun-first: bun is the mandated console toolchain (bun
# install / bun run build), so console/bun.lock IS tracked — this is an
# application repo and builds are pinned. npm is not used for the
# console; package-lock.json stays ignored.
node_modules/
.next/
out/
package-lock.json

# Environment & secrets
.env
.env.*
!.env.example

# Logs & temp
*.log
/tmp/

# Internal working files (not part of the product)
worklog.md
agent-ctx/
.claude/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
